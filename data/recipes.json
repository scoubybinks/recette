    {
      "id": "r_mw861o51rqzm8",
      "title": "Quiche lorraine",
      "description": "",
      "categoryIds": [
        "c_plat"
      ],
      "servings": 4,
      "prepMinutes": null,
      "cookMinutes": 50,
      "image": "",
      "source": "",
      "notes": "4 oeufs pour une quiche plus ferme",
      "favorite": false,
      "ingredients": [
        {
          "ingredientId": "i_oeufs",
          "name": "œufs",
          "qty": "3",
          "unit": "",
          "note": ""
        },
        {
          "ingredientId": "i_creme-fraiche",
          "name": "crème fraîche",
          "qty": "20",
          "unit": "cl",
          "note": ""
        },
        {
          "ingredientId": "i_lait",
          "name": "lait",
          "qty": "20",
          "unit": "cl",
          "note": ""
        },
        {
          "ingredientId": "i_mw861o50wzuci",
          "name": "pâte brisée",
          "qty": "1",
          "unit": "",
          "note": "(ou feuilletée)"
        },
        {
          "ingredientId": "i_noix-de-muscade",
          "name": "noix de muscade",
          "qty": "",
          "unit": "",
          "note": ""
        },
        {
          "ingredientId": "i_mw861o51robiq",
          "name": "lardons",
          "qty": "200",
          "unit": "g",
          "note": "(ou équivalent)"
        }
      ],
      "steps": [
        {
          "text": "Préchauffer le four à 180°",
          "timerSeconds": null
        },
        {
          "text": "Battre les oeufs, la crème fraîche et le lait",
          "timerSeconds": null
        },
        {
          "text": "Ajouter lardons, oignons etc... (Éponger si gras)",
          "timerSeconds": null
        },
        {
          "text": "Assaisonner sel, poivre et muscade",
          "timerSeconds": null
        },
        {
          "text": "Cuire au four 45-50min",
          "timerSeconds": 2700
        }
      ],
      "createdAt": "2026-11-08T18:28:49.908Z",
      "updatedAt": "2026-11-08T18:28:49.908Z"
    },
    {
      "id": "r_mw855t4gwemoq",
      "title": "Tortillas",
      "description": "Tortillas wrap",
      "categoryIds": [
        "c_mw84y52w4q3bd"
      ],
      "servings": 8,
      "prepMinutes": null,
      "cookMinutes": null,
      "image": "",
      "source": "",
      "notes": "Il vaut aplatir jusqu'à avoir un demi-centimètre d'épaisseur environ, puis étirer un peu la galette.",
      "favorite": false,
      "ingredients": [
        {
          "ingredientId": "i_sel",
          "name": "sel",
          "qty": "1",
          "unit": "c. à c.",
          "note": ""
        },
        {
          "ingredientId": "i_farine",
          "name": "farine",
          "qty": "400",
          "unit": "g",
          "note": ""
        },
        {
          "ingredientId": "i_huile-d-olive",
          "name": "huile d'olive",
          "qty": "10",
          "unit": "cl",
          "note": ""
        },
        {
          "ingredientId": "i_mw855t4gqbpax",
          "name": "eau",
          "qty": "15",
          "unit": "cl",
          "note": ""
        }
      ],
      "steps": [
        {
          "text": "Mélanger sel et farine",
          "timerSeconds": null
        },
        {
          "text": "Ajouter l'huile d'olive et mélanger",
          "timerSeconds": null
        },
        {
          "text": "Progressivement ajouter de l'eau. (Si c'est trop farineux encore, rajouter un peu d'eau) Ça ne doit pas être collant.",
          "timerSeconds": null
        },
        {
          "text": "Aplatir les wraps avec un rouleau, puis les cuire à la poêle avec de l'huile d'olive.",
          "timerSeconds": null
        }
      ],
      "createdAt": "2026-11-08T18:04:03.375Z",
      "updatedAt": "2026-11-08T18:04:03.375Z"
    },
    {
      "id": "r_crepes",
      "title": "Crêpes",
      "description": "La pâte à crêpes classique, pour 15 crêpes environ.",
      "categoryIds": [
        "c_petit-dej",
        "c_dessert",
        "c_vege"
      ],
      "servings": 4,
      "prepMinutes": 10,
      "cookMinutes": 20,
      "image": "",
      "source": "",
      "notes": "Une cuillère de rhum ou de fleur d'oranger dans la pâte, c'est encore meilleur.",
      "favorite": false,
      "ingredients": [
        {
          "ingredientId": "i_farine",
          "name": "farine",
          "qty": "250",
          "unit": "g",
          "note": ""
        },
        {
          "ingredientId": "i_oeufs",
          "name": "œufs",
          "qty": "4",
          "unit": "",
          "note": ""
        },
        {
          "ingredientId": "i_lait",
          "name": "lait",
          "qty": "50",
          "unit": "cl",
          "note": ""
        },
        {
          "ingredientId": "i_beurre",
          "name": "beurre",
          "qty": "50",
          "unit": "g",
          "note": "fondu"
        },
        {
          "ingredientId": "i_sel",
          "name": "sel",
          "qty": "1",
          "unit": "pincée",
          "note": ""
        },
        {
          "ingredientId": "i_sucre",
          "name": "sucre",
          "qty": "2",
          "unit": "c. à s.",
          "note": ""
        }
      ],
      "steps": [
        {
          "text": "Mettre la farine et le sel dans un saladier, creuser un puits et y casser les œufs.",
          "timerSeconds": null
        },
        {
          "text": "Verser le lait petit à petit en fouettant pour éviter les grumeaux, puis ajouter le beurre fondu et le sucre.",
          "timerSeconds": null
        },
        {
          "text": "Laisser reposer la pâte 1 h à température ambiante.",
          "timerSeconds": 3600
        },
        {
          "text": "Cuire les crêpes dans une poêle chaude légèrement beurrée, environ 1 min de chaque côté.",
          "timerSeconds": null
        }
      ],
      "createdAt": "2026-10-30T12:00:00.000Z",
      "updatedAt": "2026-10-30T12:00:00.000Z"
    },
    {
      "id": "r_carbonara",
      "title": "Pâtes à la carbonara",
      "description": "La vraie, sans crème.",
      "categoryIds": [
        "c_plat",
        "c_rapide"
      ],
      "servings": 4,
      "prepMinutes": 10,
      "cookMinutes": 12,
      "image": "",
      "source": "",
      "notes": "",
      "favorite": false,
      "ingredients": [
        {
          "ingredientId": "i_spaghetti",
          "name": "spaghetti",
          "qty": "400",
          "unit": "g",
          "note": ""
        },
        {
          "ingredientId": "i_guanciale",
          "name": "guanciale",
          "qty": "150",
          "unit": "g",
          "note": "ou lardons"
        },
        {
          "ingredientId": "i_jaunes-d-oeufs",
          "name": "jaunes d'œufs",
          "qty": "4",
          "unit": "",
          "note": ""
        },
        {
          "ingredientId": "i_pecorino",
          "name": "pecorino",
          "qty": "80",
          "unit": "g",
          "note": "râpé"
        },
        {
          "ingredientId": "i_poivre-noir",
          "name": "poivre noir",
          "qty": "",
          "unit": "",
          "note": "du moulin"
        }
      ],
      "steps": [
        {
          "text": "Porter une grande casserole d'eau salée à ébullition et cuire les spaghetti 10 min.",
          "timerSeconds": 600
        },
        {
          "text": "Pendant ce temps, faire dorer le guanciale coupé en lardons dans une poêle sans matière grasse.",
          "timerSeconds": null
        },
        {
          "text": "Mélanger les jaunes d'œufs, le pecorino et beaucoup de poivre.",
          "timerSeconds": null
        },
        {
          "text": "Égoutter les pâtes en gardant une louche d'eau de cuisson. Hors du feu, mélanger pâtes, guanciale et crème d'œufs en ajoutant un peu d'eau de cuisson pour napper.",
          "timerSeconds": null
        }
      ],
      "createdAt": "2026-10-30T12:00:00.000Z",
      "updatedAt": "2026-10-30T12:00:00.000Z"
    },
    {
      "id": "r_ratatouille",
      "title": "Ratatouille",
      "description": "Le plat d'été du Sud, encore meilleur réchauffé.",
      "categoryIds": [
        "c_plat",
        "c_vege"
      ],
      "servings": 6,
      "prepMinutes": 30,
      "cookMinutes": 60,
      "image": "",
      "source": "",
      "notes": "",
      "favorite": false,
      "ingredients": [
        {
          "ingredientId": "i_aubergines",
          "name": "aubergines",
          "qty": "2",
          "unit": "",
          "note": ""
        },
        {
          "ingredientId": "i_courgettes",
          "name": "courgettes",
          "qty": "3",
          "unit": "",
          "note": ""
        },
        {
          "ingredientId": "i_poivrons",
          "name": "poivrons",
          "qty": "2",
          "unit": "",
          "note": ""
        },
        {
          "ingredientId": "i_tomates",
          "name": "tomates",
          "qty": "6",
          "unit": "",
          "note": ""
        },
        {
          "ingredientId": "i_oignons",
          "name": "oignons",
          "qty": "2",
          "unit": "",
          "note": ""
        },
        {
          "ingredientId": "i_ail",
          "name": "ail",
          "qty": "3",
          "unit": "gousses",
          "note": ""
        },
        {
          "ingredientId": "i_huile-d-olive",
          "name": "huile d'olive",
          "qty": "4",
          "unit": "c. à s.",
          "note": ""
        },
        {
          "ingredientId": "i_thym",
          "name": "thym",
          "qty": "1",
          "unit": "brin",
          "note": ""
        },
        {
          "ingredientId": "i_sel",
          "name": "sel",
          "qty": "",
          "unit": "",
          "note": ""
        }
      ],
      "steps": [
        {
          "text": "Couper tous les légumes en dés d'environ 2 cm. Émincer les oignons et l'ail.",
          "timerSeconds": null
        },
        {
          "text": "Faire revenir les oignons dans l'huile d'olive 5 min, puis ajouter les poivrons et cuire encore 5 min.",
          "timerSeconds": null
        },
        {
          "text": "Ajouter aubergines et courgettes, faire revenir 10 min en remuant.",
          "timerSeconds": null
        },
        {
          "text": "Ajouter les tomates, l'ail et le thym, saler, couvrir et laisser mijoter 40 min à feu doux.",
          "timerSeconds": 2400
        }
      ],
      "createdAt": "2026-10-30T12:00:00.000Z",
      "updatedAt": "2026-10-30T12:00:00.000Z"
    },
    {
      "id": "r_mousse",
      "title": "Mousse au chocolat",
      "description": "Aérienne, avec seulement 3 ingrédients.",
      "categoryIds": [
        "c_dessert",
        "c_vege"
      ],
      "servings": 6,
      "prepMinutes": 20,
      "cookMinutes": null,
      "image": "",
      "source": "",
      "notes": "",
      "favorite": false,
      "ingredients": [
        {
          "ingredientId": "i_chocolat-noir",
          "name": "chocolat noir",
          "qty": "200",
          "unit": "g",
          "note": ""
        },
        {
          "ingredientId": "i_oeufs",
          "name": "œufs",
          "qty": "6",
          "unit": "",
          "note": ""
        },
        {
          "ingredientId": "i_sel",
          "name": "sel",
          "qty": "1",
          "unit": "pincée",
          "note": ""
        }
      ],
      "steps": [
        {
          "text": "Faire fondre le chocolat au bain-marie, puis le laisser tiédir.",
          "timerSeconds": null
        },
        {
          "text": "Séparer les blancs des jaunes. Incorporer les jaunes au chocolat.",
          "timerSeconds": null
        },
        {
          "text": "Monter les blancs en neige ferme avec la pincée de sel.",
          "timerSeconds": null
        },
        {
          "text": "Incorporer délicatement les blancs au chocolat en trois fois, sans les casser.",
          "timerSeconds": null
        },
        {
          "text": "Réserver au réfrigérateur au moins 3 h avant de servir.",
          "timerSeconds": 10800
        }
      ],
      "createdAt": "2026-10-30T12:00:00.000Z",
      "updatedAt": "2026-10-30T12:00:00.000Z"
    },
    {
      "id": "r_veloute-potiron",
      "title": "Velouté de potiron",
      "description": "Une soupe douce et réconfortante pour l'automne.",
      "categoryIds": [
        "c_soupe",
        "c_entree",
        "c_vege"
      ],
      "servings": 4,
      "prepMinutes": 15,
      "cookMinutes": 25,
      "image": "",
      "source": "",
      "notes": "",
      "favorite": false,
      "ingredients": [
        {
          "ingredientId": "i_potiron",
          "name": "potiron",
          "qty": "1",
          "unit": "kg",
          "note": ""
        },
        {
          "ingredientId": "i_pommes-de-terre",
          "name": "pommes de terre",
          "qty": "2",
          "unit": "",
          "note": ""
        },
        {
          "ingredientId": "i_oignons",
          "name": "oignons",
          "qty": "1",
          "unit": "",
          "note": ""
        },
        {
          "ingredientId": "i_bouillon-de-legumes",
          "name": "bouillon de légumes",
          "qty": "1",
          "unit": "l",
          "note": ""
        },
        {
          "ingredientId": "i_creme-fraiche",
          "name": "crème fraîche",
          "qty": "10",
          "unit": "cl",
          "note": ""
        },
        {
          "ingredientId": "i_noix-de-muscade",
          "name": "noix de muscade",
          "qty": "",
          "unit": "",
          "note": ""
        },
        {
          "ingredientId": "i_sel",
          "name": "sel",
          "qty": "",
          "unit": "",
          "note": ""
        },
        {
          "ingredientId": "i_poivre-noir",
          "name": "poivre noir",
          "qty": "",
          "unit": "",
          "note": ""
        }
      ],
      "steps": [
        {
          "text": "Éplucher et couper le potiron, les pommes de terre et l'oignon en morceaux.",
          "timerSeconds": null
        },
        {
          "text": "Faire revenir l'oignon 3 min dans une cocotte avec un filet d'huile.",
          "timerSeconds": null
        },
        {
          "text": "Ajouter le potiron, les pommes de terre et le bouillon. Cuire 25 min à frémissement.",
          "timerSeconds": 1500
        },
        {
          "text": "Mixer, ajouter la crème, la muscade, saler et poivrer.",
          "timerSeconds": null
        }
      ],
      "createdAt": "2026-10-30T12:00:00.000Z",
      "updatedAt": "2026-10-30T12:00:00.000Z"
